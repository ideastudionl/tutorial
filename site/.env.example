# Vul deze in Vercel in onder Settings → Environment Variables.
# Zet ze NOOIT in de repository.

# Resend — verstuurt de offerteaanvragen per e-mail (resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
QUOTE_TO_EMAIL=info@interflexstuc.nl
QUOTE_FROM_EMAIL=offerte@interflexstuc.nl

# Supabase — bewaart de aanvragen en regelt de inlog op het portal
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# Portal — wachtwoord om de aanvragen te bekijken op /portal/
PORTAL_PASSWORD=kies-iets-langs-en-willekeurigs

# Meting — laat leeg om niets te laden. Zolang alle vier leeg zijn, plaatst de
# site geen enkele advertentiecookie en verschijnt er geen cookiebanner.
PUBLIC_GA4_ID=G-XXXXXXXXXX
PUBLIC_ADS_ID=AW-123456789
PUBLIC_ADS_CONVERSIE_LABEL=AbC-D_efGh12
PUBLIC_META_PIXEL_ID=
