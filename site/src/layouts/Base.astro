---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';
import Toestemming from '../components/Toestemming.astro';
import { site } from '../data/site';
import { businessSchema, breadcrumbSchema } from '../lib/schema';
import { ogImages } from '../data/og';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD, bijvoorbeeld FAQ of een dienst. */
  schema?: object[];
  crumbs?: { name: string; url?: string }[];
  /** Het offertevenster weglaten op pagina's die de wizard al tonen. */
  noModal?: boolean;
}

const { title, description, schema = [], crumbs, noModal = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;

// Deelafbeelding: de bestandsnaam volgt het pad (/diensten/betonlook/ ->
// diensten-betonlook). Bestaat die niet, dan pakken we de algemene.
const ogSlug = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const ogImage = new URL(
  `/og/${ogImages.has(ogSlug) ? ogSlug : 'home'}.jpg`,
  Astro.site ?? site.url,
).href;

const blocks = [businessSchema(), ...(crumbs ? [breadcrumbSchema(crumbs)] : []), ...schema];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A1626" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Lettertypes staan op ons eigen domein: geen externe verbinding, geen
         extra wachttijd voor de eerste tekst, en niets dat naar Google lekt. -->
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-sans-3-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {blocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>

  <body>
    <a class="ifs-skip-link" href="#content">Naar de inhoud springen</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    {!noModal && <QuoteModal />}

    <div class="ifs-sticky-cta">
      <a class="ifs-btn ifs-btn--ghost" href={site.phoneHref}>Bel direct</a>
      <a class="ifs-btn" href="/offerte/" data-quote-open>Offerte aanvragen</a>
    </div>

    <Toestemming />

    <script>
      import '../scripts/main.js';
      import '../scripts/herkomst.js';
      import '../scripts/toestemming.js';
    </script>
  </body>
</html>
