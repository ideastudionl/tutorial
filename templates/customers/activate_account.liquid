<div class="container section container--narrow">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {% form 'activate_customer_password' %}
    {{ form.errors | default_errors }}
    <label class="field"><span class="field__label">{{ 'customer.register.password' | t }}</span>
      <input type="password" name="customer[password]" class="input" autocomplete="new-password" required></label>
    <label class="field"><span class="field__label">{{ 'customer.reset_password.password_confirm' | t }}</span>
      <input type="password" name="customer[password_confirmation]" class="input" autocomplete="new-password" required></label>
    <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
  {% endform %}
</div>
