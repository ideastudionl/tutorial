<div class="container section container--narrow">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <label class="field"><span class="field__label">{{ 'customer.register.first_name' | t }}</span>
      <input type="text" name="customer[first_name]" class="input" autocomplete="given-name"></label>
    <label class="field"><span class="field__label">{{ 'customer.register.last_name' | t }}</span>
      <input type="text" name="customer[last_name]" class="input" autocomplete="family-name"></label>
    <label class="field"><span class="field__label">{{ 'customer.register.email' | t }}</span>
      <input type="email" name="customer[email]" class="input" autocomplete="email" required></label>
    <label class="field"><span class="field__label">{{ 'customer.register.password' | t }}</span>
      <input type="password" name="customer[password]" class="input" autocomplete="new-password" required></label>
    <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
  {% endform %}
  <p style="margin-top:1rem">{{ 'customer.register.has_account' | t }}
    <a href="{{ routes.account_login_url }}" class="link">{{ 'customer.register.login' | t }}</a></p>
</div>
