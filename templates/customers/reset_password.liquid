<div class="wrap" style="max-width:440px;min-height:60vh">
  <div class="page-head"><h1>Wachtwoord opnieuw instellen</h1></div>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<p style="color:#b00;margin-bottom:14px">{{ form.errors | default_errors }}</p>{%- endif -%}
    <input type="password" name="customer[password]" placeholder="Nieuw wachtwoord" required style="width:100%;padding:14px;border:1px solid var(--line);border-radius:2px;margin-bottom:12px">
    <input type="password" name="customer[password_confirmation]" placeholder="Bevestig wachtwoord" required style="width:100%;padding:14px;border:1px solid var(--line);border-radius:2px;margin-bottom:20px">
    <button type="submit" class="btn btn--dark" style="width:100%;justify-content:center">Opslaan</button>
  {%- endform -%}
</div>
