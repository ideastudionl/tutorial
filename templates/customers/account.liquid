<div class="wrap" style="min-height:60vh">
  <div class="page-head"><h1>Mijn account</h1></div>
  <div style="max-width:820px;margin:0 auto 60px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px">
      <p>Welkom, {{ customer.first_name | default: customer.email }}</p>
      <a href="{{ routes.account_logout_url }}" class="link-arrow">Uitloggen</a>
    </div>
    <h3 class="serif" style="font-size:22px;margin-bottom:16px">Bestellingen</h3>
    {%- paginate customer.orders by 12 -%}
      {%- if customer.orders.size > 0 -%}
        <table style="width:100%;border-collapse:collapse;font-size:14px">
          <thead><tr style="text-align:left;border-bottom:1px solid var(--line)"><th style="padding:10px 0">Order</th><th>Datum</th><th>Status</th><th>Totaal</th></tr></thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr style="border-bottom:1px solid var(--line)"><td style="padding:12px 0"><a href="{{ order.customer_url }}" style="text-decoration:underline">{{ order.name }}</a></td><td>{{ order.created_at | date: '%d-%m-%Y' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.total_price | money }}</td></tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p style="color:var(--muted)">Je hebt nog geen bestellingen geplaatst.</p>
      {%- endif -%}
    {%- endpaginate -%}
    <p style="margin-top:30px"><a href="{{ routes.account_addresses_url }}" class="link-arrow">Adressen beheren</a></p>
  </div>
</div>
