<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#16130F;color:#F4EEE2;text-align:center;padding:40px">
  <div style="max-width:460px">
    <div class="logo__name" style="color:#F4EEE2;font-size:30px">{{ settings.logo_text | default: 'BELAMONTE' }}</div>
    <div class="logo__sub">{{ settings.logo_tagline }}</div>
    <h1 style="font-size:34px;margin:30px 0 14px">Binnenkort online</h1>
    <p style="color:#B6AD9C;line-height:1.7;margin-bottom:30px">{{ page_description | default: 'Onze nieuwe webshop opent binnenkort. Heb je het wachtwoord? Log dan hieronder in.' }}</p>
    {%- form 'storefront_password' -%}
      <div style="display:flex;gap:10px;max-width:380px;margin:0 auto">
        <input type="password" name="password" placeholder="Wachtwoord" style="flex:1;padding:15px;border:none;border-radius:2px">
        <button type="submit" class="btn btn--gold">Betreden</button>
      </div>
      {%- if form.errors -%}<p style="color:#E7C96B;margin-top:14px">{{ form.errors.translated_fields.password }} {{ form.errors.messages.password }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</div>
