<section class="section" id="{{ section.settings.anchor | default: 'cadeau' }}">
  <div class="wrap">
    <div class="gift">
      <div class="gift__text">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--gold" style="margin-top:32px">{{ section.settings.button_label }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="4" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </a>
        {%- endif -%}
      </div>
      <div class="gift__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
        {%- else -%}
          <img src="{{ 'packaging.jpg' | asset_url }}" alt="BelaMonte cadeauverpakking" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cadeau-banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenschrift", "default": "Cadeausets" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Geschenken die indruk maken" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Stel een persoonlijke cadeauset samen of kies een kant-en-klaar geschenk. Elk pakket komt in de luxe, mat-zwarte BelaMonte-doos met gouden folie — klaar om te geven." },
    { "type": "text", "id": "button_label", "label": "Knop label", "default": "Stel een cadeau samen" },
    { "type": "url", "id": "button_link", "label": "Knop link" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding" },
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "cadeau" }
  ],
  "presets": [{ "name": "Cadeau-banner" }]
}
{% endschema %}
