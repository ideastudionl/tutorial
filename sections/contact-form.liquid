<section class="section">
  <div class="container">
    <div class="contact">
      <div>
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="rte lede">{{ section.settings.text }}</div>
        {%- endif -%}

        <dl class="contact__details">
          {%- if settings.company_email != blank -%}
            <div>
              <dt>{% render 'icon', name: 'mail', size: 18 %}E-mail</dt>
              <dd><a href="mailto:{{ settings.company_email }}">{{ settings.company_email }}</a></dd>
            </div>
          {%- endif -%}
          {%- if settings.company_phone != blank -%}
            <div>
              <dt>{% render 'icon', name: 'phone', size: 18 %}Telefoon</dt>
              <dd><a href="tel:{{ settings.company_phone | remove: ' ' }}">{{ settings.company_phone }}</a></dd>
            </div>
          {%- endif -%}
          {%- if settings.support_hours != blank -%}
            <div>
              <dt>{% render 'icon', name: 'clock', size: 18 %}Bereikbaar</dt>
              <dd>{{ settings.support_hours }}</dd>
            </div>
          {%- endif -%}
          {%- if settings.company_address != blank -%}
            <div>
              <dt>{% render 'icon', name: 'box', size: 18 %}Adres</dt>
              <dd>{{ settings.company_address }}</dd>
            </div>
          {%- endif -%}
          {%- if settings.company_kvk != blank -%}
            <div><dt>KvK</dt><dd>{{ settings.company_kvk }}</dd></div>
          {%- endif -%}
          {%- if settings.company_vat != blank -%}
            <div><dt>BTW</dt><dd>{{ settings.company_vat }}</dd></div>
          {%- endif -%}
        </dl>
      </div>

      <div class="contact__form">
        {% form 'contact' %}
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success">{{ 'contact.form.success' | t }}</p>
          {%- endif -%}
          {{ form.errors | default_errors }}

          <label class="field">
            <span class="field__label">{{ 'contact.form.name' | t }}</span>
            <input type="text" name="contact[name]" class="input" autocomplete="name" required>
          </label>
          <label class="field">
            <span class="field__label">{{ 'contact.form.email' | t }}</span>
            <input type="email" name="contact[email]" class="input" autocomplete="email" required>
          </label>
          <label class="field">
            <span class="field__label">{{ 'contact.form.order_number' | t }}</span>
            <input type="text" name="contact[bestelnummer]" class="input">
          </label>
          <label class="field">
            <span class="field__label">{{ 'contact.form.message' | t }}</span>
            <textarea name="contact[body]" class="textarea" required></textarea>
          </label>
          <button type="submit" class="btn btn--lg">{{ 'contact.form.send' | t }}</button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contactformulier",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Contact" },
    { "type": "richtext", "id": "text", "label": "Tekst",
      "default": "<p>Vraag over je bestelling of over een product? Stuur een bericht — we reageren zo snel mogelijk.</p>" }
  ],
  "presets": [ { "name": "Contactformulier" } ]
}
{% endschema %}
