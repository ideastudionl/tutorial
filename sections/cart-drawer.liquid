<div class="cart-drawer" id="bm-cart-drawer" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Winkelmand">
    <div class="cart-drawer__head">
      <div class="cart-drawer__title">Winkelmand <span class="cart-drawer__count" data-cart-count>{{ cart.item_count }}</span></div>
      <button class="cart-drawer__x" type="button" data-cart-close aria-label="Sluiten"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>
    </div>
    <div class="cart-drawer__body" data-cart-body>
      {%- if cart.item_count > 0 -%}
        {%- assign ship_threshold = 7500 -%}
        {%- if cart.total_price >= ship_threshold -%}
          <div class="cart-ship cart-ship--done">
            <div class="cart-ship__txt"><span class="cart-ship__ico">&#10038;</span> Gefeliciteerd — je hebt <strong>gratis verzending!</strong></div>
            <div class="cart-ship__bar"><div class="cart-ship__fill" style="width:100%"></div></div>
          </div>
        {%- else -%}
          {%- assign ship_remaining = ship_threshold | minus: cart.total_price -%}
          {%- assign ship_pct = cart.total_price | times: 100 | divided_by: ship_threshold -%}
          <div class="cart-ship">
            <div class="cart-ship__txt">Nog <strong>{{ ship_remaining | money }}</strong> tot <strong>gratis verzending</strong></div>
            <div class="cart-ship__bar"><div class="cart-ship__fill" style="width:{{ ship_pct }}%"></div></div>
          </div>
        {%- endif -%}
        <div class="cart-drawer__items">
          {%- for item in cart.items -%}
            <div class="cart-line" data-line="{{ forloop.index }}">
              <a href="{{ item.url }}" class="cart-line__media">{%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}">{%- endif -%}</a>
              <div class="cart-line__info">
                <a href="{{ item.url }}" class="cart-line__name">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<div class="cart-line__variant">{{ item.variant.title }}</div>{%- endunless -%}
                <div class="cart-line__levertijd">
                  {%- if item.product.metafields.custom.levertijd != blank -%}
                    {{ item.product.metafields.custom.levertijd }}
                  {%- elsif item.product.type == 'Sierkussens' -%}
                    Levertijd 4-5 weken
                  {%- elsif item.product.type == 'Behang' -%}
                    Levertijd 2 weken
                  {%- else -%}
                    Binnen 1-2 dagen geleverd
                  {%- endif -%}
                </div>
                <div class="cart-line__price">{{ item.final_price | money }}</div>
                <div class="cart-line__controls">
                  <div class="cart-line__qty">
                    <button type="button" data-qty-down aria-label="Minder">&minus;</button>
                    <span class="cart-line__q">{{ item.quantity }}</span>
                    <button type="button" data-qty-up aria-label="Meer">+</button>
                  </div>
                  <button type="button" class="cart-line__remove" data-remove aria-label="Verwijderen"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg></button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        {%- assign onderz = collections['onderzetters'].products -%}
        {%- assign cart_pids = ',' -%}
        {%- for it in cart.items -%}{%- assign cart_pids = cart_pids | append: it.product_id | append: ',' -%}{%- endfor -%}
        <div class="cart-recs" data-cart-recs data-product-id="{{ cart.items.first.product_id }}">
          {%- if onderz.size > 0 -%}
            <script type="application/json" data-recs-onderz>[{%- assign rc = 0 -%}{%- for pr in onderz -%}{%- assign pidw = ',' | append: pr.id | append: ',' -%}{%- if pr.available and rc < 8 -%}{%- unless cart_pids contains pidw -%}{% if rc > 0 %},{% endif %}{"id":{{ pr.selected_or_first_available_variant.id }},"title":{{ pr.title | json }},"price":{{ pr.price }},"img":{% if pr.featured_image %}{{ pr.featured_image | image_url: width: 200 | json }}{% else %}""{% endif %}}{%- assign rc = rc | plus: 1 -%}{%- endunless -%}{%- endif -%}{%- endfor -%}]</script>
          {%- endif -%}
        </div>
        <div class="cart-drawer__foot">
          <div class="cart-drawer__subtotal"><span>Subtotaal</span><span>{{ cart.total_price | money }}</span></div>
          <p class="cart-drawer__note">Verzendkosten en btw worden berekend bij het afrekenen.</p>
          <a href="{{ routes.cart_url }}" class="btn btn--outline cart-drawer__viewcart">Winkelmand bekijken</a>
          <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="btn btn--dark cart-drawer__checkout">Afrekenen</button></form>
        </div>
      {%- else -%}
        <div class="cart-drawer__empty">
          <p>Je winkelmand is nog leeg.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--dark" data-cart-close>Verder winkelen</a>
        </div>
      {%- endif -%}
    </div>
  </aside>
</div>

<style>
  /* Voorkomt horizontale overflow op mobiel (sticky header blijft werken) */
  body{ overflow-x:clip; }

  .cart-drawer{ position:fixed; inset:0; z-index:120; visibility:hidden; pointer-events:none; overflow:hidden; }
  .cart-drawer.is-open{ visibility:visible; pointer-events:auto; }
  .cart-drawer__overlay{ position:absolute; inset:0; background:rgba(12,11,9,.5); opacity:0; transition:opacity .4s ease; }
  .cart-drawer.is-open .cart-drawer__overlay{ opacity:1; }
  .cart-drawer__panel{ position:absolute; top:0; right:0; height:100%; width:min(430px,100%); max-width:100%; background:var(--cream); box-shadow:-24px 0 60px -30px rgba(0,0,0,.5); display:flex; flex-direction:column; transform:translateX(100%); transition:transform .44s cubic-bezier(.2,.7,.15,1); }
  .cart-drawer.is-open .cart-drawer__panel{ transform:translateX(0); }
  .cart-drawer__head{ display:flex; align-items:center; justify-content:space-between; padding:24px 26px; border-bottom:1px solid var(--line); }
  .cart-drawer__title{ font-family:'Playfair Display',Georgia,serif; font-size:22px; display:flex; align-items:center; gap:10px; }
  .cart-drawer__count{ font-family:'Montserrat',sans-serif; font-size:12px; font-weight:600; background:var(--panel); border-radius:20px; padding:2px 10px; }
  .cart-drawer__x{ background:none; border:none; cursor:pointer; color:var(--ink); padding:6px; display:inline-flex; transition:color .25s; }
  .cart-drawer__x:hover{ color:var(--gold); }
  .cart-drawer__body{ flex:1; overflow-y:auto; display:flex; flex-direction:column; }

  /* Gratis-verzending voortgangsbalk */
  .cart-ship{ margin:16px 26px 0; padding:13px 16px; background:#fff; border:1px solid var(--line); border-radius:6px; }
  .cart-ship__txt{ font-size:13px; color:#5C5345; display:flex; align-items:center; gap:6px; }
  .cart-ship__txt strong{ color:var(--ink); }
  .cart-ship--done .cart-ship__txt strong{ color:#1F8A5B; }
  .cart-ship__ico{ color:var(--gold); }
  .cart-ship__bar{ margin-top:9px; height:6px; background:#EFE9DD; border-radius:4px; overflow:hidden; }
  .cart-ship__fill{ height:100%; background:linear-gradient(90deg,#C49A4A,#E7C96B); border-radius:4px; transition:width .5s cubic-bezier(.2,.7,.15,1); }
  .cart-ship--done .cart-ship__fill{ background:linear-gradient(90deg,#1F8A5B,#4CAF7D); }

  .cart-drawer__items{ padding:4px 26px; }
  .cart-line{ display:grid; grid-template-columns:74px 1fr; gap:16px; padding:20px 0; border-bottom:1px solid var(--line); align-items:start; }
  .cart-line__media{ display:block; border-radius:3px; overflow:hidden; background:var(--panel); aspect-ratio:1; width:74px; height:74px; }
  .cart-line__media img{ width:100%; height:100%; object-fit:cover; }
  .cart-line__info{ min-width:0; }
  .cart-line__name{ font-family:'Playfair Display',Georgia,serif; font-size:16px; line-height:1.25; color:var(--ink); display:block; }
  .cart-line__variant{ font-size:12px; color:var(--muted); margin-top:5px; }
  .cart-line__levertijd{ font-size:12px; color:#8B8273; margin-top:4px; }
  .cart-line__price{ font-size:14px; color:var(--ink); font-weight:600; margin-top:6px; }
  .cart-line__controls{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; }
  .cart-line__qty{ display:inline-flex; align-items:center; border:1px solid var(--line); border-radius:3px; }
  .cart-line__qty button{ background:none; border:none; width:30px; height:30px; cursor:pointer; color:var(--ink); font-size:16px; line-height:1; display:inline-flex; align-items:center; justify-content:center; transition:color .2s; }
  .cart-line__qty button:hover{ color:var(--gold); }
  .cart-line__q{ min-width:30px; text-align:center; font-size:13px; }
  .cart-line__remove{ border:none; background:none; color:var(--muted); cursor:pointer; padding:4px; display:inline-flex; transition:color .25s; }
  .cart-line__remove:hover{ color:#a23; }

  /* Cross-sell: maak je bestelling compleet */
  .cart-recs{ padding:0 26px; }
  .cart-recs:empty{ display:none; }
  .cart-recs__head{ font-size:11px; letter-spacing:.14em; text-transform:uppercase; font-weight:600; color:#A8884E; margin:18px 0 4px; }
  .cart-recs__sub{ font-size:12px; color:#8B8273; margin:0 0 12px; }
  .cart-recs__row{ display:flex; gap:12px; overflow-x:auto; padding-bottom:8px; -ms-overflow-style:none; scrollbar-width:none; }
  .cart-recs__row::-webkit-scrollbar{ display:none; }
  .cart-rec{ flex:0 0 auto; width:130px; background:#fff; border:1px solid var(--line); border-radius:6px; padding:10px; display:flex; flex-direction:column; }
  .cart-rec img,.cart-rec__ph{ width:100%; aspect-ratio:1; object-fit:cover; border-radius:4px; background:var(--panel); }
  .cart-rec__name{ font-size:12.5px; line-height:1.3; color:var(--ink); margin:8px 0 2px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .cart-rec__price{ font-size:12.5px; font-weight:600; color:var(--ink); margin-bottom:8px; }
  .cart-rec__add{ margin-top:auto; width:100%; background:var(--ink); color:var(--cream); border:none; border-radius:3px; font-family:inherit; font-size:11px; letter-spacing:.06em; font-weight:600; padding:8px 6px; cursor:pointer; transition:background .25s,color .25s; }
  .cart-rec__add:hover{ background:var(--gold); color:var(--ink); }
  .cart-rec__add:disabled{ background:#1F8A5B; color:#fff; cursor:default; }

  .cart-drawer__foot{ margin-top:auto; padding:22px 26px calc(22px + env(safe-area-inset-bottom)); border-top:1px solid var(--line); background:var(--cream); position:sticky; bottom:0; }
  .cart-drawer__subtotal{ display:flex; justify-content:space-between; align-items:baseline; font-size:15px; font-weight:600; margin-bottom:6px; }
  .cart-drawer__note{ font-size:12px; color:var(--muted); margin:0 0 16px; }
  .cart-drawer__viewcart{ width:100%; justify-content:center; margin-bottom:10px; }
  .cart-drawer__checkout{ width:100%; justify-content:center; }
  .cart-drawer__empty{ padding:64px 26px; text-align:center; display:flex; flex-direction:column; gap:18px; align-items:center; color:var(--muted); }
  @media(max-width:480px){ .cart-drawer__panel{ width:100%; } .cart-drawer__items{ padding:4px 18px; } .cart-ship{ margin:14px 18px 0; } .cart-recs{ padding:0 18px; } .cart-drawer__head{ padding:20px 18px; } .cart-drawer__foot{ padding:18px 18px calc(18px + env(safe-area-inset-bottom)); } }
</style>

<script>
  (function(){
    var drawer = document.getElementById('bm-cart-drawer');
    if(!drawer) return;
    var body = drawer.querySelector('[data-cart-body]');
    function lock(on){ document.body.style.overflow = on ? 'hidden' : ''; }
    function updateCounts(n){
      document.querySelectorAll('[data-cart-count]').forEach(function(el){
        el.textContent = n;
        if(el.classList.contains('cart-count')){ el.style.display = n > 0 ? 'flex' : 'none'; }
      });
    }
    function renderRecs(wrap, items, sub){
      var html = '<div class="cart-recs__head">Maak je bestelling compleet</div>';
      if(sub){ html += '<div class="cart-recs__sub">' + sub + '</div>'; }
      html += '<div class="cart-recs__row">';
      items.forEach(function(p){
        var price = (p.price / 100).toFixed(2).replace('.', ',');
        var img = p.img ? '<img src="' + p.img + '" alt="' + (p.title || '') + '" loading="lazy">' : '<div class="cart-rec__ph"></div>';
        html += '<div class="cart-rec">' + img
          + '<div class="cart-rec__name">' + p.title + '</div>'
          + '<div class="cart-rec__price">&euro; ' + price + '</div>'
          + '<button type="button" class="cart-rec__add" data-rec-add="' + p.id + '">+ Toevoegen</button>'
          + '</div>';
      });
      html += '</div>';
      wrap.innerHTML = html;
    }
    function initRecs(){
      var wrap = drawer.querySelector('[data-cart-recs]');
      if(!wrap) return;
      // 1) Voorkeur: onderzetters als "maak compleet" add-on (server-side ingesloten, excl. wat al in de mand zit)
      var dataEl = wrap.querySelector('[data-recs-onderz]');
      if(dataEl){
        var onderz = [];
        try { onderz = JSON.parse(dataEl.textContent) || []; } catch(e){ onderz = []; }
        onderz = onderz.slice(0, 6);
        if(onderz.length){ renderRecs(wrap, onderz, 'Onderzetters die hier perfect bij passen'); return; }
      }
      // 2) Fallback: gerelateerde producten
      var pid = wrap.getAttribute('data-product-id');
      if(!pid){ wrap.innerHTML = ''; return; }
      fetch('{{ routes.root_url }}recommendations/products.json?product_id=' + pid + '&intent=related&limit=6')
        .then(function(r){ return r.json(); })
        .then(function(data){
          var items = (data.products || []).filter(function(p){ return p.available; }).slice(0, 4).map(function(p){
            var v = null;
            (p.variants || []).forEach(function(x){ if(!v && x.available){ v = x; } });
            if(!v){ v = (p.variants || [])[0]; }
            return v ? { id: v.id, title: p.title, price: p.price, img: p.featured_image } : null;
          }).filter(Boolean);
          if(!items.length){ wrap.innerHTML = ''; return; }
          renderRecs(wrap, items, null);
        }).catch(function(){ wrap.innerHTML = ''; });
    }
    function fetchSection(){
      return fetch('{{ routes.root_url }}?section_id=cart-drawer', { headers:{ 'Accept':'text/html' } })
        .then(function(r){ return r.text(); })
        .then(function(html){
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var nb = doc.querySelector('[data-cart-body]');
          if(nb && body){ body.innerHTML = nb.innerHTML; }
          initRecs();
        }).catch(function(){});
    }
    function refresh(){
      return fetch('{{ routes.cart_url }}.js', { headers:{ 'Accept':'application/json' } })
        .then(function(r){ return r.json(); })
        .then(function(cart){ updateCounts(cart.item_count); return fetchSection(); }).catch(function(){});
    }
    function open(){ drawer.classList.add('is-open'); drawer.setAttribute('aria-hidden','false'); lock(true); refresh(); }
    function close(){ drawer.classList.remove('is-open'); drawer.setAttribute('aria-hidden','true'); lock(false); }
    function change(line, qty){
      return fetch('{{ routes.cart_change_url }}.js', {
        method:'POST',
        headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
        body: JSON.stringify({ line: line, quantity: qty })
      }).then(function(r){ return r.json(); })
        .then(function(cart){ updateCounts(cart.item_count); return fetchSection(); }).catch(function(){});
    }
    function addVariant(id, btn){
      if(btn){ btn.disabled = true; btn.textContent = 'Toegevoegd ✓'; }
      return fetch('{{ routes.cart_add_url }}.js', {
        method:'POST',
        headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
        body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
      }).then(function(r){ return r.json(); })
        .then(function(){ return refresh(); })
        .catch(function(){ if(btn){ btn.disabled = false; btn.textContent = '+ Toevoegen'; } });
    }
    window.bmCart = { open: open, close: close, refresh: refresh };

    document.addEventListener('click', function(e){
      if(e.target.closest('[data-cart-toggle]')){ e.preventDefault(); open(); return; }
      if(e.target.closest('[data-cart-close]')){ close(); return; }
    });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape'){ close(); } });

    drawer.addEventListener('click', function(e){
      var recAdd = e.target.closest('[data-rec-add]');
      if(recAdd){ addVariant(recAdd.getAttribute('data-rec-add'), recAdd); return; }
      var lineEl = e.target.closest('[data-line]');
      if(!lineEl) return;
      var line = parseInt(lineEl.getAttribute('data-line'), 10);
      var qEl = lineEl.querySelector('.cart-line__q');
      var q = qEl ? parseInt(qEl.textContent, 10) : 1;
      if(e.target.closest('[data-qty-up]')){ change(line, q + 1); }
      else if(e.target.closest('[data-qty-down]')){ change(line, Math.max(0, q - 1)); }
      else if(e.target.closest('[data-remove]')){ change(line, 0); }
    });

    initRecs();
  })();
</script>

{% schema %}
{ "name": "Cart drawer" }
{% endschema %}
