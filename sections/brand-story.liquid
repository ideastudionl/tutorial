{%- liquid
  assign media = section.settings.image
-%}
<section class="editorial">
  <div class="editorial__inner">
    <div class="editorial__text">
      {%- if section.settings.show_logo -%}<img src="{{ 'logo-gold.png' | asset_url }}" alt="{{ shop.name }}">{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="editorial__stats">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              <div class="n">{{ block.settings.number }}</div>
              <div class="l">{{ block.settings.label }}</div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="editorial__media">
      {%- if media != blank -%}
        <img src="{{ media | image_url: width: 1200 }}" alt="{{ media.alt | escape }}" loading="lazy">
      {%- else -%}
        <img src="{{ 'kussen-06.jpg' | asset_url }}" alt="BelaMonte interieur" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Merkverhaal",
  "settings": [
    { "type": "checkbox", "id": "show_logo", "label": "Toon gouden logo", "default": true },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Breng karakter, rust en elegantie in jouw interieur" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "BelaMonte staat voor tijdloze woonaccessoires van hoogwaardige materialen — van geweven sierkussens tot marmeren dienbladen en serene wanddecoratie. Elk stuk is gekozen om generaties mee te gaan en jouw ruimte een warme, luxueuze signatuur te geven." },
    { "type": "image_picker", "id": "image", "label": "Afbeelding" }
  ],
  "blocks": [
    { "type": "stat", "name": "Statistiek", "settings": [
      { "type": "text", "id": "number", "label": "Getal", "default": "120+" },
      { "type": "text", "id": "label", "label": "Label", "default": "Woonaccessoires" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Merkverhaal", "blocks": [
      { "type": "stat", "settings": { "number": "3", "label": "Hoofdcollecties" } },
      { "type": "stat", "settings": { "number": "120+", "label": "Woonaccessoires" } },
      { "type": "stat", "settings": { "number": "4.9", "label": "Klantbeoordeling" } }
    ] }
  ]
}
{% endschema %}
