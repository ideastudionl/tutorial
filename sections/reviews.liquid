{%- capture stars5 -%}{%- for i in (1..5) -%}<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7L12 2Z"/></svg>{%- endfor -%}{%- endcapture -%}
<section class="section">
  <div class="wrap">
    <div class="section__head">
      <div class="reviews__stars">{%- for i in (1..5) -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7L12 2Z"/></svg>{%- endfor -%}</div>
      <h2 style="font-size:clamp(28px,3.4vw,42px)">{{ section.settings.heading }}</h2>
    </div>
    <div class="review-grid">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="s">{{ stars5 }}</div>
          <p>&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <div class="who">{{ block.settings.name }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "4.9 / 5 — door 1.240+ klanten" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Citaat" },
      { "type": "text", "id": "name", "label": "Naam · plaats" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Reviews", "blocks": [
      { "type": "review", "settings": { "quote": "De sierkussens voelen écht luxe — zwaar, mooi geweven en de kleuren kloppen precies met de foto. Mijn bank is compleet.", "name": "Sanne · Amsterdam" } },
      { "type": "review", "settings": { "quote": "Snel geleverd en wat een verpakking! Als cadeau gekocht voor mijn moeder, ze was sprakeloos. Echt een premium ervaring.", "name": "Mark · Eindhoven" } },
      { "type": "review", "settings": { "quote": "Eindelijk woonaccessoires die kwaliteit uitstralen zonder kil te zijn. Warm, tijdloos en perfect af te wisselen.", "name": "Laura · Rotterdam" } }
    ] }
  ]
}
{% endschema %}
