          <summary style="cursor:pointer;list-style:none;padding:20px 2px;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600">Afmetingen &amp; materiaal</summary>
          <div style="font-size:14px;line-height:1.8;color:#5C5345;padding:0 2px 22px">{{ p.metafields.custom.afmetingen }}</div>
