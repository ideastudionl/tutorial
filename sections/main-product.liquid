        {%- endif -%}
        <details style="border-bottom:1px solid #EAE3D6">
          <summary style="cursor:pointer;list-style:none;padding:20px 2px;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600">Levering &amp; retour</summary>
          <div style="font-size:14px;line-height:1.8;color:#5C5345;padding:0 2px 22px">Gratis verzending vanaf € 75. Levertijd: 1 à 2 werkdagen, tenzij anders aangegeven. 14 dagen retour — Eenvoudig retourneren.</div>
        </details>
