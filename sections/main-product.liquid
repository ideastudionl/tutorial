  </div>

  {%- assign rec = p.collections.first.products -%}
  {%- if rec.size > 1 -%}
    <section style="padding:0 0 80px">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:30px;gap:16px">
        <h2 style="font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(24px,2.6vw,34px);margin:0">Maak het compleet</h2>
        <div style="display:flex;align-items:center;gap:14px;flex-shrink:0">
          <a href="{{ p.collections.first.url }}" class="link-arrow">Meer uit {{ p.collections.first.title }}</a>
          <div class="pdp-recs-navs">
            <button type="button" class="pdp-recs-nav" data-recs-prev aria-label="Vorige">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="15 6 9 12 15 18"/></svg>
            </button>
            <button type="button" class="pdp-recs-nav" data-recs-next aria-label="Volgende">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="9 6 15 12 9 18"/></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="pdp-recs" data-recs-track>
        {%- assign shown = 0 -%}
        {%- for rp in rec -%}
          {%- if rp.id != p.id and shown < 8 -%}
            {%- render 'product-card', product: rp -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
    <script>
      (function(){
        var track = document.querySelector('[data-recs-track]');
        if(!track) return;
        function step(){ var c = track.querySelector('.prod-card'); return (c ? c.offsetWidth : 260) + 20; }
        var prev = document.querySelector('[data-recs-prev]'), next = document.querySelector('[data-recs-next]');
        if(prev) prev.addEventListener('click', function(){ track.scrollBy({left: -step()*2, behavior:'smooth'}); });
        if(next) next.addEventListener('click', function(){ track.scrollBy({left: step()*2, behavior:'smooth'}); });
      })();
    </script>
  {%- endif -%}
</div>

