{%- liquid
  assign current = product.selected_or_first_available_variant
  assign benefit = product.metafields.custom.short_benefit.value
-%}
<div class="container" data-product-root>
  {% render 'breadcrumbs' %}

  <div class="pdp">
    <div class="pdp__gallery" data-gallery>
      <div class="gallery__track" data-gallery-track>
        {%- for media in product.media -%}
          <div class="gallery__slide media media--square" data-gallery-slide data-media-id="{{ media.id }}">
            {{ media | image_url: width: 1400 | image_tag:
                 loading: forloop.first | default: false | ternary: 'eager', 'lazy',
                 widths: '400,600,800,1000,1200,1400',
                 sizes: '(min-width: 990px) 55vw, 100vw',
                 alt: media.alt | default: product.title | escape,
                 fetchpriority: forloop.first | default: false | ternary: 'high', 'auto' }}
          </div>
        {%- else -%}
          <div class="gallery__slide media media--square">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 -%}
        <span class="gallery__counter" data-gallery-counter>1 / {{ product.media.size }}</span>
        <div class="gallery__thumbs">
          {%- for media in product.media limit: 8 -%}
            <button type="button" data-gallery-thumb class="{% if forloop.first %}is-active{% endif %}"
              aria-label="{{ 'products.product.image_of' | t: index: forloop.index, total: product.media.size }}">
              <div class="media media--square">
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,200', sizes: '90px', alt: '' }}
              </div>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp__buy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'rating' -%}
            <div {{ block.shopify_attributes }}>{% render 'rating', product: product, class: 'rating--lg' %}</div>

          {%- when 'title' -%}
            <h1 {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'benefit' -%}
            {%- if benefit != blank -%}
              <p class="buy__benefit" {{ block.shopify_attributes }}>{{ benefit }}</p>
            {%- endif -%}

          {%- when 'price' -%}
            <div data-price-host {{ block.shopify_attributes }}>
              {% render 'price', target: current, product: product, class: 'price--lg' %}
            </div>

          {%- when 'stock' -%}
            <p class="buy__stock" {{ block.shopify_attributes }}>
              {%- if current.available -%}
                {% render 'icon', name: 'check-circle', size: 15 %}{{ 'products.product.in_stock' | t }}
              {%- else -%}
                {{ 'products.product.out_of_stock' | t }}
              {%- endif -%}
            </p>

          {%- when 'form' -%}
            <div {{ block.shopify_attributes }}>
              {%- unless product.has_only_default_variant -%}
                <div data-variant-picker>
                  {%- for option in product.options_with_values -%}
                    <div class="opt" data-option-index="{{ forloop.index0 }}">
                      <div class="opt__label">
                        <span>{{ option.name }}</span>
                        <span data-option-value>{{ option.selected_value }}</span>
                      </div>
                      <div class="opt__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = 'Option-' | append: section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                          <span style="position:relative">
                            <input type="radio" id="{{ input_id }}" name="option-{{ forloop.parentloop.index0 }}"
                              value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                            <label for="{{ input_id }}">{{ value }}</label>
                          </span>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

              {% form 'product', product, data-product-form: true, novalidate: 'novalidate' %}
                <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
                <div class="buy__row" data-atc-anchor>
                  {% render 'quantity-input', id: 'Quantity-' | append: section.id, name: 'quantity', value: 1, min: 1 %}
                  <button type="submit" name="add" class="btn btn--full btn--lg" data-add-button
                    {% unless current.available %}disabled{% endunless %}>
                    <span data-add-label>
                      {%- if current.available -%}{{ 'products.product.add_to_cart' | t }}
                      {%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                    </span>
                  </button>
                </div>
                <span class="field__error" data-cart-error hidden></span>
                {{ form | payment_button }}
              {% endform %}
            </div>

          {%- when 'trust' -%}
            <div class="buy__trust" {{ block.shopify_attributes }}>
              {%- if block.settings.shipping != blank -%}
                <div>{% render 'icon', name: 'truck', size: 18 %}<span>{{ block.settings.shipping }}</span></div>
              {%- endif -%}
              {%- if block.settings.returns != blank -%}
                <div>{% render 'icon', name: 'return', size: 18 %}<span>{{ block.settings.returns }}</span></div>
              {%- endif -%}
              {%- if block.settings.quality != blank -%}
                <div>{% render 'icon', name: 'leaf', size: 18 %}<span>{{ block.settings.quality }}</span></div>
              {%- endif -%}
            </div>

          {%- when 'accordion' -%}
            {%- assign acc_content = block.settings.content -%}
            {%- if block.settings.metafield != blank -%}
              {%- assign mf_parts = block.settings.metafield | split: '.' -%}
              {%- assign mf = product.metafields[mf_parts[0]][mf_parts[1]].value -%}
              {%- if mf != blank -%}{%- assign acc_content = mf -%}{%- endif -%}
            {%- endif -%}
            {%- if acc_content != blank -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary class="accordion__summary">
                  {{ block.settings.heading }}
                  {% render 'icon', name: 'plus', size: 18, class: 'accordion__icon' %}
                </summary>
                <div class="accordion__content rte">{{ acc_content }}</div>
              </details>
            {%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary class="accordion__summary">
                  {{ 'products.product.description' | t }}
                  {% render 'icon', name: 'plus', size: 18, class: 'accordion__icon' %}
                </summary>
                <div class="accordion__content rte">{{ product.description }}</div>
              </details>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} Variant data for the picker, including a rendered price so the
  buy box never has to format money in JavaScript. {%- endcomment -%}
<script type="application/json" data-variant-json>
  [
    {%- for v in product.variants -%}
      {
        "id": {{ v.id }},
        "available": {{ v.available | json }},
        "options": {{ v.options | json }},
        "featured_media_id": {{ v.featured_media.id | default: null | json }},
        "price_html": {% capture vp %}{% render 'price', target: v, product: product, class: 'price--lg' %}{% endcapture %}{{ vp | strip | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

{% render 'sticky-atc', product: product %}
{% render 'schema-product', product: product %}

{% schema %}
{
  "name": "Product",
  "blocks": [
    { "type": "rating", "name": "Beoordeling", "limit": 1 },
    { "type": "title", "name": "Titel", "limit": 1 },
    { "type": "benefit", "name": "Korte belofte", "limit": 1 },
    { "type": "price", "name": "Prijs", "limit": 1 },
    { "type": "stock", "name": "Voorraadstatus", "limit": 1 },
    { "type": "form", "name": "Varianten en bestelknop", "limit": 1 },
    {
      "type": "trust", "name": "Vertrouwensregels", "limit": 1,
      "settings": [
        { "type": "text", "id": "shipping", "label": "Verzending", "default": "Gratis verzending in Nederland. België €5,95." },
        { "type": "text", "id": "returns", "label": "Retour", "default": "14 dagen bedenktijd." },
        { "type": "text", "id": "quality", "label": "Kwaliteit", "default": "Origineel Forever-product uit eigen voorraad." }
      ]
    },
    { "type": "description", "name": "Omschrijving" },
    {
      "type": "accordion", "name": "Uitklapbaar blok",
      "settings": [
        { "type": "text", "id": "heading", "label": "Kop", "default": "Hoe gebruik je het?" },
        { "type": "richtext", "id": "content", "label": "Vaste tekst" },
        { "type": "text", "id": "metafield", "label": "Metafield (bijv. custom.usage)",
          "info": "Als dit metafield gevuld is, gaat het voor op de vaste tekst." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "rating" }, { "type": "title" }, { "type": "benefit" },
      { "type": "price" }, { "type": "stock" }, { "type": "form" }, { "type": "trust" },
      { "type": "accordion", "settings": { "heading": "Wat zit erin?", "metafield": "custom.contents" } },
      { "type": "accordion", "settings": { "heading": "Hoe gebruik je het?", "metafield": "custom.usage" } },
      { "type": "accordion", "settings": { "heading": "Voor wie?", "metafield": "custom.suitable_for" } },
      { "type": "accordion", "settings": { "heading": "Ingrediënten", "metafield": "custom.ingredients" } },
      { "type": "description" }
    ]
  }
}
{% endschema %}
