<script>
  var productData = {{ product | json }};
  var variants = productData.variants;

  function findVariant(options) {
    return variants.find(function(v) {
      return v.options.every(function(opt, i) {
        var key = 'options[' + productData.options[i] + ']';
        return options[key] === opt;
      });
    });
  }

  function updateProduct(variant) {
    if (!variant) return;
    var priceEl = document.querySelector('.pdp__price');
    if (priceEl) priceEl.textContent = '€' + (variant.price / 100).toFixed(2).replace('.', ',');
    if (variant.featured_image) {
      var mainImg = document.querySelector('.bm-pdp-main img');
      if (mainImg) mainImg.src = variant.featured_image.src;
    }
    var idInput = document.querySelector('select[name="id"], input[name="id"]');
    if (idInput) {
      idInput.value = variant.id;
      if (idInput.tagName === 'SELECT') {
        var option = idInput.querySelector('option[value="' + variant.id + '"]');
        if (option) option.selected = true;
      }
    }
    history.replaceState({}, '', '?variant=' + variant.id);
  }

  function initSwatches() {
    var labels = document.querySelectorAll('.swatch-label');
    if (labels.length === 0) {
      setTimeout(initSwatches, 100);
      return;
    }
    labels.forEach(function(label) {
      label.addEventListener('click', function() {
        var radio = this.querySelector('input[type="radio"]');
        if (!radio) return;
        var options = {};
        productData.options.forEach(function(optName) {
          var selected = document.querySelector('input[name="options[' + optName + ']"]:checked');
          if (selected) options['options[' + optName + ']'] = selected.value;
        });
        options['options[Kleur]'] = radio.value;
        labels.forEach(function(l) { l.classList.remove('active'); });
        this.classList.add('active');
        var variant = findVariant(options);
        updateProduct(variant);
      });
    });
  }

  initSwatches();
</script>




<style>
  .pdp{ display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:start; }
  .pdp__stars{ display:flex; align-items:center; gap:9px; margin:10px 0 2px; }
  .pdp__starrow{ display:inline-flex; gap:2px; color:#C49A4A; line-height:0; }
  .pdp__starcount{ font-size:12.5px; color:#6F6658; letter-spacing:.01em; }
  .bm-pdp-gallery{ display:flex; flex-direction:column; gap:14px; }
  .bm-pdp-main{ position:relative; border-radius:6px; overflow:hidden; background:var(--panel); aspect-ratio:1/1; }
  .bm-pdp-main img{ width:100%; height:100%; object-fit:cover; display:block; }
  .bm-pdp-thumbs{ display:flex; flex-direction:row; flex-wrap:nowrap; gap:10px; overflow-x:auto; padding-bottom:4px; -ms-overflow-style:none; scrollbar-width:thin; }
  .bm-pdp-thumbs::-webkit-scrollbar{ height:5px; }
  .bm-pdp-thumbs::-webkit-scrollbar-thumb{ background:#DCD3C4; border-radius:3px; }
  .bm-pdp-thumbs .bm-thumb{ width:72px; height:72px; padding:0; border:1px solid var(--line); border-radius:4px; overflow:hidden; background:none; cursor:pointer; transition:border-color .2s; flex:0 0 72px; }
  .bm-pdp-thumbs .bm-thumb.is-active{ border-color:var(--gold); }
  .bm-pdp-thumbs .bm-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
  .pdp__info{ position:sticky; top:100px; align-self:start; }
  @media(max-width:900px){ .pdp{ grid-template-columns:1fr; gap:26px; } .pdp__info{ position:static; } }

  /* Maak het compleet — horizontale carousel */
  .pdp-recs{ display:flex; gap:20px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; padding-bottom:12px; -ms-overflow-style:none; scrollbar-width:thin; }
  .pdp-recs::-webkit-scrollbar{ height:6px; }
  .pdp-recs::-webkit-scrollbar-thumb{ background:#DCD3C4; border-radius:3px; }
  .pdp-recs > *{ flex:0 0 calc((100% - 60px) / 4); scroll-snap-align:start; }
  .pdp-recs-navs{ display:flex; gap:8px; }
  .pdp-recs-nav{ width:38px; height:38px; display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--line); border-radius:50%; background:#fff; color:#5C5345; cursor:pointer; transition:border-color .2s,color .2s; }
  .pdp-recs-nav:hover{ border-color:var(--gold); color:var(--gold); }
  @media(max-width:900px){ .pdp-recs > *{ flex:0 0 calc((100% - 20px) / 2); } .pdp-recs-navs{ display:none; } }
  @media(max-width:520px){ .pdp-recs > *{ flex:0 0 82%; } }
</style>

