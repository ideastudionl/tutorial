<section class="section section--brand">
  <div class="container">
    <div class="measure">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}
      <div class="hero__cta">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--on-dark btn--lg">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="btn btn--on-dark-ghost btn--lg">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Afsluitende CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Klaar om te bestellen?" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "cta_label", "label": "Knop 1", "default": "Bekijk de collectie" },
    { "type": "url", "id": "cta_link", "label": "Link knop 1" },
    { "type": "text", "id": "cta2_label", "label": "Knop 2" },
    { "type": "url", "id": "cta2_link", "label": "Link knop 2" }
  ],
  "presets": [ { "name": "Afsluitende CTA" } ]
}
{% endschema %}
