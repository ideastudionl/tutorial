{%- liquid
  assign img = section.settings.image
  assign align = section.settings.alignment | default: 'left'
-%}
<style>
  #hero-{{ section.id }} .hero__content{
    {% if align == 'center' %}margin-left:auto;margin-right:auto;text-align:center;align-items:center;{% elsif align == 'right' %}margin-left:auto;text-align:right;{% else %}margin-right:auto;text-align:left;{% endif %}
  }
  #hero-{{ section.id }} .hero__content .hero__eyebrow{ {% if align == 'center' %}justify-content:center;{% elsif align == 'right' %}justify-content:flex-end;{% endif %} }
  #hero-{{ section.id }} .hero__content .hero__cta{ {% if align == 'center' %}justify-content:center;{% elsif align == 'right' %}justify-content:flex-end;{% endif %} }
  #hero-{{ section.id }} .hero__img{ transform-origin:60% 50%; will-change:transform; }
  #hero-{{ section.id }} .bm-rise{ opacity:1; }
  @media(prefers-reduced-motion:no-preference){
    #hero-{{ section.id }} .hero__img{ animation:bmKenBurns 20s ease-in-out infinite alternate; }
    #hero-{{ section.id }} .bm-rise{ opacity:0; animation:bmRise 1s cubic-bezier(.2,.7,.15,1) forwards; }
  }
  #hero-{{ section.id }} .bm-rise.d1{ animation-delay:.15s } #hero-{{ section.id }} .bm-rise.d2{ animation-delay:.3s }
  #hero-{{ section.id }} .bm-rise.d3{ animation-delay:.5s } #hero-{{ section.id }} .bm-rise.d4{ animation-delay:.7s }
  @keyframes bmRise{ from{opacity:0;transform:translateY(26px)} to{opacity:1;transform:translateY(0)} }
  @keyframes bmKenBurns{ from{transform:scale(1.04)} to{transform:scale(1.15)} }
</style>
<section class="hero" id="hero-{{ section.id }}">
  {%- if img != blank -%}
    <img class="hero__img" src="{{ img | image_url: width: 2000 }}" alt="{{ img.alt | escape }}" loading="eager" width="2000" height="1125">
  {%- else -%}
    <img class="hero__img" src="{{ 'kussen-03.jpg' | asset_url }}" alt="BelaMonte sierkussens" loading="eager">
  {%- endif -%}
  <div class="hero__overlay"></div>
  <div class="wrap" style="position:relative">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="hero__eyebrow bm-rise d1"><span>{{ section.settings.eyebrow }}</span><span class="rule"></span></div>
      {%- endif -%}
      <h1 class="bm-rise d2">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %} {{ section.settings.heading_after }}</h1>
      {%- if section.settings.text != blank -%}<p class="bm-rise d3">{{ section.settings.text }}</p>{%- endif -%}
      <div class="hero__cta bm-rise d4">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--gold">{{ section.settings.button_label }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="4" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a href="{{ section.settings.button2_link }}" class="btn btn--ghost">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Achtergrondafbeelding" },
    { "type": "select", "id": "alignment", "label": "Uitlijning tekst", "default": "left",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Gecentreerd" },
        { "value": "right", "label": "Rechts" }
      ] },
    { "type": "text", "id": "eyebrow", "label": "Bovenschrift", "default": "Nieuwe collectie" },
    { "type": "text", "id": "heading", "label": "Kop deel 1", "default": "Sierkussens die je" },
    { "type": "text", "id": "heading_accent", "label": "Kop accent (cursief)", "default": "interieur" },
    { "type": "text", "id": "heading_after", "label": "Kop deel 2", "default": "laten leven" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Luxe geweven stoffen, velours en subtiele glans in warme aardetinten. Met de hand samengesteld voor een tijdloze, hotel-chic uitstraling." },
    { "type": "text", "id": "button_label", "label": "Knop 1 label", "default": "Shop sierkussens" },
    { "type": "url", "id": "button_link", "label": "Knop 1 link" },
    { "type": "text", "id": "button2_label", "label": "Knop 2 label", "default": "Ontdek de collectie" },
    { "type": "url", "id": "button2_link", "label": "Knop 2 link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
