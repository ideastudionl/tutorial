{%- liquid
  assign coll = collections[section.settings.collection]
  assign products_to_show = coll.products
  assign limit = section.settings.products_to_show
-%}
<section class="section" id="{{ section.settings.anchor | default: 'sierkussens' }}">
  <div class="wrap">
    <div class="section__bar">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if coll.url != blank -%}
        <a href="{{ coll.url }}" class="link-arrow">{{ section.settings.link_label | default: 'Bekijk alles' }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="4" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="prod-grid">
      {%- if products_to_show.size > 0 -%}
        {%- for product in products_to_show limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Demo fallback so the homepage looks complete before products are added {%- endcomment -%}
        {%- assign demo_imgs = "kussen-01.jpg,kussen-05.jpg,kussen-06.jpg,kussen-09.jpg,kussen-08.jpg,kussen-07.jpg" | split: "," -%}
        {%- assign demo_names = "Bronze Weave,Champagne Velvet,Linnen Noir,Pearl Chenille,Silver Croco,Sand Fringe" | split: "," -%}
        {%- assign demo_mat = "Geweven jacquard,Velours,Linnenlook · bies,Chenille,Velvet · reliëf,Geweven · franje" | split: "," -%}
        {%- assign demo_size = "45 × 45 cm,50 × 50 cm,45 × 45 cm,50 × 50 cm,40 × 60 cm,50 × 50 cm" | split: "," -%}
        {%- assign demo_price = "€ 49,95,€ 44,95,€ 39,95,€ 42,95,€ 47,95,€ 45,95" | split: "," -%}
        {%- for img in demo_imgs limit: limit -%}
          {%- assign idx = forloop.index0 -%}
          <div class="prod-card">
            <span class="prod-card__media">
              <img src="{{ img | asset_url }}" alt="{{ demo_names[idx] }}" loading="lazy">
              {%- if idx == 0 -%}<span class="prod-card__tag">Nieuw</span>{%- elsif idx == 3 -%}<span class="prod-card__tag">Bestseller</span>{%- endif -%}
            </span>
            <div class="prod-card__body">
              <div class="prod-card__cat">{{ demo_mat[idx] }}</div>
              <h3 class="prod-card__name">{{ demo_names[idx] }}</h3>
              <div class="prod-card__sub">{{ demo_size[idx] }}</div>
              <div class="swatches">
                <span class="swatch" style="background:#7A5A39"></span>
                <span class="swatch" style="background:#C9A36B"></span>
                <span class="swatch" style="background:#E6DAC5"></span>
              </div>
              <div class="prod-card__foot">
                <span class="prod-card__price">{{ demo_price[idx] }}</span>
                <span class="btn-add" style="opacity:.5">In mand</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if products_to_show.size == 0 -%}
      <p style="text-align:center;color:var(--muted);font-size:13px;margin-top:24px">Voorbeeldweergave — koppel een collectie in de editor om je eigen sierkussens te tonen.</p>
    {%- endif -%}
  </div>
</section>

<style>
  #{{ section.settings.anchor | default: 'sierkussens' }} .prod-grid{ grid-template-columns:repeat(4,1fr); }
  @media(max-width:900px){ #{{ section.settings.anchor | default: 'sierkussens' }} .prod-grid{ grid-template-columns:1fr 1fr; } }
  @media(max-width:520px){ #{{ section.settings.anchor | default: 'sierkussens' }} .prod-grid{ grid-template-columns:1fr; } }
</style>

{% schema %}
{
  "name": "Uitgelichte collectie",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenschrift", "default": "Nieuw binnen · Woonkamer" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "De Sierkussens collectie" },
    { "type": "collection", "id": "collection", "label": "Collectie" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Aantal producten", "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link-label", "default": "Alle sierkussens" },
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "sierkussens" }
  ],
  "presets": [{ "name": "Uitgelichte collectie" }]
}
{% endschema %}
