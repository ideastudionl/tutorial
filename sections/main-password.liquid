<div style="text-align:center">
  {%- if settings.logo -%}
    {{ settings.logo | image_url: width: 400 | image_tag: loading: 'eager', widths: '150,300,400', sizes: '150px', alt: shop.name | escape }}
  {%- else -%}
    <h1>{{ shop.name }}</h1>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <h2 style="margin-top:var(--sp-6)">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if shop.password_message != blank -%}
    <div class="rte">{{ shop.password_message }}</div>
  {%- endif -%}

  <div style="margin-top:var(--sp-8);text-align:left">
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <label class="field">
        <span class="field__label">{{ section.settings.password_label }}</span>
        <input type="password" name="password" class="input" autocomplete="current-password" required>
      </label>
      <button type="submit" class="btn btn--full">{{ section.settings.submit_label }}</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Wachtwoordpagina",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "We zijn bijna zover" },
    { "type": "text", "id": "password_label", "label": "Label wachtwoordveld", "default": "Wachtwoord" },
    { "type": "text", "id": "submit_label", "label": "Knop", "default": "Toegang" }
  ]
}
{% endschema %}
