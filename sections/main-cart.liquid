<div class="container section" data-cart-section="main-cart">
  <span hidden data-cart-count-source="{{ cart.item_count }}"></span>
  <h1>{{ 'sections.cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="note" style="max-width:52ch">
      <p><strong>{{ 'sections.cart.empty' | t }}</strong></p>
      <p>{{ 'sections.cart.empty_help' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page">
      <div>
        {%- for line in cart.items -%}
          <div class="cart-row">
            <a href="{{ line.url }}" class="media media--square" style="width:96px;flex:none">
              {%- if line.image -%}
                {{ line.image | image_url: width: 250 | image_tag: loading: 'lazy', widths: '120,250', sizes: '96px',
                     alt: line.image.alt | default: line.product.title | escape }}
              {%- endif -%}
            </a>
            <div style="flex:1;min-width:0">
              <a href="{{ line.url }}" style="font-weight:600;text-decoration:none">{{ line.product.title }}</a>
              {%- unless line.product.has_only_default_variant -%}
                <p class="text-sm text-soft" style="margin:.2rem 0 0">{{ line.variant.title }}</p>
              {%- endunless -%}
              <div style="display:flex;align-items:center;gap:var(--sp-4);margin-top:var(--sp-3);flex-wrap:wrap">
                {% render 'quantity-input', id: 'PageQty-', name: 'updates[]', value: line.quantity, min: 0, line: forloop.index %}
                <button type="button" class="text-sm" data-cart-remove data-line="{{ forloop.index }}"
                  style="border:0;background:none;padding:0;cursor:pointer;text-decoration:underline;color:var(--c-ink-soft)">
                  {{ 'sections.cart.remove' | t }}
                </button>
              </div>
            </div>
            <b>{{ line.final_line_price | money }}</b>
          </div>
        {%- endfor -%}
      </div>

      <aside class="cart-summary">
        {% render 'free-shipping-bar' %}
        <div style="display:flex;align-items:baseline;justify-content:space-between;margin:var(--sp-4) 0 .3rem">
          <span>{{ 'sections.cart.subtotal' | t }}</span>
          <b style="font-size:1.35rem">{{ cart.total_price | money }}</b>
        </div>
        <p class="text-xs text-soft" style="margin-bottom:var(--sp-4)">{{ 'sections.cart.shipping_note' | t }}</p>

        {%- if settings.cart_show_note -%}
          <label class="field">
            <span class="field__label">{{ 'sections.cart.note' | t }}</span>
            <textarea class="textarea" name="note">{{ cart.note }}</textarea>
          </label>
        {%- endif -%}

        <button type="submit" name="checkout" class="btn btn--full btn--lg">{{ 'sections.cart.checkout' | t }}</button>

        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="payment-icons" style="justify-content:center;margin-top:var(--sp-4)">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </aside>
    </form>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Winkelwagen", "settings": [] }
{% endschema %}
