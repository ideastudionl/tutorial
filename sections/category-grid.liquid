<section class="section">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>

    <div class="grid grid--4">
      {%- for block in section.blocks -%}
        {%- assign c = collections[block.settings.collection] -%}
        <a href="{{ c.url | default: block.settings.link }}" class="category-card" {{ block.shopify_attributes }}>
          <div class="media media--landscape">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy',
                   widths: '250,400,600', sizes: '(min-width: 750px) 25vw, 45vw',
                   alt: c.title | default: block.settings.title | escape }}
            {%- elsif c.featured_image -%}
              {{ c.featured_image | image_url: width: 600 | image_tag: loading: 'lazy',
                   widths: '250,400,600', sizes: '(min-width: 750px) 25vw, 45vw',
                   alt: c.title | escape }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="category-card__body">
            <strong>{{ block.settings.title | default: c.title }}</strong>
            {%- if c != blank -%}<small>{{ c.products_count }}</small>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorieën",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkop", "default": "Vind sneller wat je zoekt" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Waar ben je naar op zoek?" },
    { "type": "text", "id": "text", "label": "Tekst" }
  ],
  "blocks": [
    {
      "type": "category", "name": "Categorie", "limit": 12,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collectie" },
        { "type": "text", "id": "title", "label": "Titel (overschrijft de collectienaam)" },
        { "type": "image_picker", "id": "image", "label": "Afbeelding" },
        { "type": "url", "id": "link", "label": "Link (als je geen collectie kiest)" }
      ]
    }
  ],
  "presets": [ { "name": "Categorieën" } ]
}
{% endschema %}
