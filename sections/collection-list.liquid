<section class="section" id="collist-{{ section.id }}">
  <div class="wrap">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="flourish"><svg width="120" height="12" viewBox="0 0 120 12" fill="none"><line x1="2" y1="6" x2="47" y2="6" stroke="#C49A4A" stroke-width="1"/><path d="M60 1.5 L65 6 L60 10.5 L55 6 Z" stroke="#C49A4A" stroke-width="1"/><line x1="73" y1="6" x2="118" y2="6" stroke="#C49A4A" stroke-width="1"/></svg></div>
    </div>
    <div class="cat-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          assign img = block.settings.image
          if img == blank and coll.featured_image != blank
            assign img = coll.featured_image
          endif
          assign title = block.settings.heading
          if title == blank
            assign title = coll.title
          endif
          assign url = coll.url | default: block.settings.link | default: '#'
        -%}
        <a href="{{ url }}" class="cat-card" {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            <img src="{{ img | image_url: width: 700 }}" alt="{{ title | escape }}" loading="lazy">
          {%- elsif block.settings.fallback_image != blank -%}
            <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ title | escape }}" loading="lazy">
          {%- else -%}
            <div class="ph"><span>sfeerbeeld volgt</span></div>
          {%- endif -%}
          <div class="grad"></div>
          {%- if block.settings.badge != blank -%}<span class="badge">{{ block.settings.badge }}</span>{%- endif -%}
          <div class="meta">
            <div class="name">{{ title }}</div>
            {%- if block.settings.subtitle != blank -%}<div class="sub">{{ block.settings.subtitle }}</div>{%- endif -%}
            <div class="go">Bekijk <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="4" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg></div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #collist-{{ section.id }} .cat-grid{ grid-template-columns:repeat(4,1fr); gap:24px; }
  #collist-{{ section.id }} .cat-card{ aspect-ratio:4/5; }
  @media(max-width:820px){ #collist-{{ section.id }} .cat-grid{ grid-template-columns:1fr 1fr; } }
  @media(max-width:520px){ #collist-{{ section.id }} .cat-grid{ grid-template-columns:1fr; } #collist-{{ section.id }} .cat-card{ aspect-ratio:3/4; } }
</style>

{% schema %}
{
  "name": "Categorie-grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenschrift", "default": "Het assortiment" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Shop per categorie" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collectie" },
        { "type": "text", "id": "heading", "label": "Titel (overschrijft collectienaam)" },
        { "type": "text", "id": "subtitle", "label": "Subtitel" },
        { "type": "text", "id": "badge", "label": "Badge (bv. Nieuw)" },
        { "type": "image_picker", "id": "image", "label": "Afbeelding (overschrijft collectie)" },
        { "type": "text", "id": "fallback_image", "label": "Theme-asset bestandsnaam (bv. kussen-05.jpg)" },
        { "type": "url", "id": "link", "label": "Link (indien geen collectie)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Categorie-grid",
      "blocks": [
        { "type": "category", "settings": { "heading": "Sierkussens", "subtitle": "Velours · geweven · franje", "badge": "Nieuw", "fallback_image": "kussen-05.jpg" } },
        { "type": "category", "settings": { "heading": "Woonkamer Accessoires", "subtitle": "Vazen · spiegels · kaarsen · schalen", "fallback_image": "wandkunst-lifestyle.jpg" } },
        { "type": "category", "settings": { "heading": "Badkamer Accessoires", "subtitle": "Handdoeken · wasmanden · opbergers" } }
      ]
    }
  ]
}
{% endschema %}
