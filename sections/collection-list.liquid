<section class="section" id="collist-{{ section.id }}">
  <div class="wrap">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="flourish"><svg width="120" height="12" viewBox="0 0 120 12" fill="none"><line x1="2" y1="6" x2="47" y2="6" stroke="#C49A4A" stroke-width="1"/><path d="M60 1.5 L65 6 L60 10.5 L55 6 Z" stroke="#C49A4A" stroke-width="1"/><line x1="73" y1="6" x2="118" y2="6" stroke="#C49A4A" stroke-width="1"/></svg></div>
    </div>
    <div class="cat-navrow">
      <button type="button" data-cat-prev="{{ section.id }}" aria-label="Vorige"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="15 6 9 12 15 18"/></svg></button>
      <button type="button" data-cat-next="{{ section.id }}" aria-label="Volgende"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="9 6 15 12 9 18"/></svg></button>
    </div>
    <div class="cat-grid cat-carousel" data-cat-track="{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          assign img = block.settings.image
          if img == blank and coll.featured_image != blank
            assign img = coll.featured_image
          endif
          assign title = block.settings.heading
          if title == blank
            assign title = coll.title
          endif
          assign url = coll.url | default: block.settings.link | default: '#'
        -%}
        <a href="{{ url }}" class="cat-card" {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            <img src="{{ img | image_url: width: 700 }}" alt="{{ title | escape }}" loading="lazy">
          {%- elsif block.settings.fallback_image != blank -%}
            <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ title | escape }}" loading="lazy">
          {%- else -%}
            <div class="ph"><span>sfeerbeeld volgt</span></div>
          {%- endif -%}
          <div class="grad"></div>
          {%- if block.settings.badge != blank -%}<span class="badge">{{ block.settings.badge }}</span>{%- endif -%}
          <div class="meta">
            <div class="name">{{ title }}</div>
            {%- if block.settings.subtitle != blank -%}<div class="sub">{{ block.settings.subtitle }}</div>{%- endif -%}
            <div class="go">Bekijk <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="4" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg></div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #collist-{{ section.id }} .cat-carousel{ display:flex; gap:24px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; padding-bottom:10px; scrollbar-width:thin; }
  #collist-{{ section.id }} .cat-carousel::-webkit-scrollbar{ height:6px; }
  #collist-{{ section.id }} .cat-carousel::-webkit-scrollbar-thumb{ background:#DCD3C4; border-radius:3px; }
  #collist-{{ section.id }} .cat-carousel > *{ flex:0 0 calc((100% - 72px) / 3.35); scroll-snap-align:start; }
  #collist-{{ section.id }} .cat-card{ aspect-ratio:4/5; }
  #collist-{{ section.id }} .cat-navrow{ display:flex; justify-content:flex-end; gap:8px; margin-bottom:18px; }
  #collist-{{ section.id }} .cat-navrow button{ width:38px; height:38px; display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--line); border-radius:50%; background:#fff; color:#5C5345; cursor:pointer; transition:border-color .2s,color .2s; }
  #collist-{{ section.id }} .cat-navrow button:hover{ border-color:var(--gold); color:var(--gold); }
  @media(max-width:820px){ #collist-{{ section.id }} .cat-carousel > *{ flex:0 0 calc((100% - 24px) / 2.25); } }
  @media(max-width:520px){ #collist-{{ section.id }} .cat-carousel > *{ flex:0 0 80%; } #collist-{{ section.id }} .cat-card{ aspect-ratio:3/4; } #collist-{{ section.id }} .cat-navrow{ display:none; } }
</style>
<script>
  (function(){
    var id = {{ section.id | json }};
    var track = document.querySelector('[data-cat-track="' + id + '"]');
    if(!track) return;
    function step(){ var c = track.querySelector('.cat-card'); return (c ? c.offsetWidth : 300) + 24; }
    var prev = document.querySelector('[data-cat-prev="' + id + '"]');
    var next = document.querySelector('[data-cat-next="' + id + '"]');
    if(prev) prev.addEventListener('click', function(){ track.scrollBy({ left: -step() * 2, behavior: 'smooth' }); });
    if(next) next.addEventListener('click', function(){ track.scrollBy({ left: step() * 2, behavior: 'smooth' }); });
  })();
</script>

{% schema %}
{
  "name": "Categorie-grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenschrift", "default": "Het assortiment" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Shop per categorie" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collectie" },
        { "type": "text", "id": "heading", "label": "Titel (overschrijft collectienaam)" },
        { "type": "text", "id": "subtitle", "label": "Subtitel" },
        { "type": "text", "id": "badge", "label": "Badge (bv. Nieuw)" },
        { "type": "image_picker", "id": "image", "label": "Afbeelding (overschrijft collectie)" },
        { "type": "text", "id": "fallback_image", "label": "Theme-asset bestandsnaam (bv. kussen-05.jpg)" },
        { "type": "url", "id": "link", "label": "Link (indien geen collectie)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Categorie-grid",
      "blocks": [
        { "type": "category", "settings": { "heading": "Sierkussens", "subtitle": "Velours · geweven · franje", "badge": "Nieuw", "fallback_image": "kussen-05.jpg" } },
        { "type": "category", "settings": { "heading": "Woonkamer Accessoires", "subtitle": "Vazen · spiegels · kaarsen · schalen", "fallback_image": "wandkunst-lifestyle.jpg" } },
        { "type": "category", "settings": { "heading": "Badkamer Accessoires", "subtitle": "Handdoeken · wasmanden · opbergers" } }
      ]
    }
  ]
}
{% endschema %}
