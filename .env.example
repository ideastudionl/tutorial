# Redis (Upstash) voor cloud-opslag van taken.
# Lokaal mag dit leeg blijven: dan gebruikt de app data/tasks.json.
#
# Op Vercel worden deze meestal automatisch ingevuld nadat je via
# Storage een Upstash Redis-database koppelt. Voor lokaal testen met
# Redis kun je ze hier (in .env.local) zelf invullen.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# De Vercel-integratie gebruikt soms deze namen in plaats van bovenstaande;
# beide worden ondersteund:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
