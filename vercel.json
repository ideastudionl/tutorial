{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/server/offerte.php", "destination": "/api/offerte" }
  ],
  "headers": [
    {
      "source": "/configurator/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
    }
  ]
}
