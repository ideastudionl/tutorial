<div class="container section">
  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="link">{{ 'customer.log_out' | t }}</a>
  </div>

  <h2>{{ 'customer.account.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size == 0 -%}
      <p class="text-soft">{{ 'customer.account.no_orders' | t }}</p>
    {%- else -%}
      <table>
        <thead><tr>
          <th>{{ 'customer.orders.order_number' | t }}</th>
          <th>{{ 'customer.orders.date' | t }}</th>
          <th>{{ 'customer.orders.payment_status' | t }}</th>
          <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
          <th>{{ 'customer.orders.total' | t }}</th>
        </tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}" class="link">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%-d %b %Y' }}</td>
              <td>{{ order.financial_status_label }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endif -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}

  <h2 style="margin-top:2.5rem">{{ 'customer.account.details' | t }}</h2>
  {{ customer.default_address | format_address }}
  <p><a href="{{ routes.account_addresses_url }}" class="link">{{ 'customer.account.view_addresses' | t }}</a></p>
</div>
