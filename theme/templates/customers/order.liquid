<div class="container section">
  <h1>{{ 'customer.orders.order_number' | t }} {{ order.name }}</h1>
  <p class="text-soft">{{ order.created_at | date: '%-d %B %Y' }}</p>
  <table>
    <thead><tr>
      <th>{{ 'customer.orders.product' | t }}</th>
      <th>{{ 'customer.orders.quantity' | t }}</th>
      <th>{{ 'customer.orders.price' | t }}</th>
    </tr></thead>
    <tbody>
      {%- for line in order.line_items -%}
        <tr><td>{{ line.title }}</td><td>{{ line.quantity }}</td><td>{{ line.final_line_price | money }}</td></tr>
      {%- endfor -%}
    </tbody>
  </table>
  <p style="margin-top:1.5rem"><strong>{{ 'customer.orders.total' | t }}: {{ order.total_price | money }}</strong></p>
  <p><a href="{{ routes.account_url }}" class="link">{{ 'customer.account.return' | t }}</a></p>
</div>
