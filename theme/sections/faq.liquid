<section class="section">
  <div class="container container--narrow">
    <div class="section-head" style="justify-content:center;text-align:center">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    {%- for block in section.blocks -%}
      <details class="accordion" {{ block.shopify_attributes }}>
        <summary class="accordion__summary">
          {{ block.settings.question }}
          {% render 'icon', name: 'plus', size: 18, class: 'accordion__icon' %}
        </summary>
        <div class="accordion__content rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Veelgestelde vragen",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkop" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Veelgestelde vragen" }
  ],
  "blocks": [
    {
      "type": "qa", "name": "Vraag",
      "settings": [
        { "type": "text", "id": "question", "label": "Vraag" },
        { "type": "richtext", "id": "answer", "label": "Antwoord" }
      ]
    }
  ],
  "presets": [ { "name": "Veelgestelde vragen" } ]
}
{% endschema %}
