{%- liquid
  assign p = section.settings.product
  assign v = p.selected_or_first_available_variant
-%}
<section class="section{% if section.settings.background == 'sand' %} section--sand{% endif %}">
  <div class="container">
    <div class="spotlight">
      <div class="spotlight__media">
        <div class="media media--portrait">
          {%- if section.settings.image -%}
            {{ section.settings.image | image_url: width: 1000 | image_tag:
                 loading: 'lazy', widths: '400,600,800,1000',
                 sizes: '(min-width: 990px) 42vw, 92vw',
                 alt: section.settings.image.alt | default: p.title | escape }}
          {%- elsif p.featured_media -%}
            {{ p.featured_media | image_url: width: 1000 | image_tag:
                 loading: 'lazy', widths: '400,600,800,1000',
                 sizes: '(min-width: 990px) 42vw, 92vw',
                 alt: p.featured_media.alt | default: p.title | escape }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="spotlight__body">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | default: p.title }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte lede">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
        {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}

        {%- if benefit_blocks.size > 0 -%}
          <ul class="spotlight__benefits">
            {%- for block in benefit_blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'icon', name: 'check', size: 17 %}{{ block.settings.text }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if step_blocks.size > 0 -%}
          {%- comment -%}
            Numbered because the C9 genuinely is a dated sequence. Do not reuse
            this block for a list that has no order — see docs/04-design-system.md.
          {%- endcomment -%}
          <ol class="steps">
            {%- for block in step_blocks -%}
              <li {{ block.shopify_attributes }}>
                <b>{{ block.settings.label }}</b>
                <div>
                  <p>{{ block.settings.heading }}</p>
                  {%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        <div class="spotlight__foot">
          {%- if p != blank -%}
            <a href="{{ p.url }}" class="btn btn--lg">
              {{ section.settings.cta_label | default: 'Bekijk dit product' }}
            </a>
            {% render 'price', target: v, product: p, class: 'price--lg' %}
          {%- elsif section.settings.cta_link != blank -%}
            <a href="{{ section.settings.cta_link }}" class="btn btn--lg">{{ section.settings.cta_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product uitgelicht",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding (anders de productfoto)" },
    { "type": "text", "id": "eyebrow", "label": "Bovenkop", "default": "Het bekendste programma" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "De C9 kuur" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "cta_label", "label": "Knop", "default": "Bekijk de C9" },
    { "type": "url", "id": "cta_link", "label": "Link (als je geen product kiest)" },
    { "type": "select", "id": "background", "label": "Achtergrond", "default": "sand",
      "options": [ { "value": "white", "label": "Wit" }, { "value": "sand", "label": "Zacht" } ] }
  ],
  "blocks": [
    { "type": "benefit", "name": "Voordeel",
      "settings": [ { "type": "text", "id": "text", "label": "Tekst" } ] },
    { "type": "step", "name": "Stap",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "DAG 1–2",
          "info": "Gebruik dit blok alleen voor een echte volgorde. Nummering die niets betekent leest als opvulling." },
        { "type": "text", "id": "heading", "label": "Kop" },
        { "type": "textarea", "id": "text", "label": "Toelichting" }
      ] }
  ],
  "presets": [ { "name": "Product uitgelicht" } ]
}
{% endschema %}
