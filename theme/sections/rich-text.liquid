<section class="section{% if section.settings.background == 'sand' %} section--sand{% endif %}">
  <div class="container container--narrow">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.cta_label != blank -%}
      <p style="margin-top:var(--sp-6)">
        <a href="{{ section.settings.cta_link }}" class="btn">{{ section.settings.cta_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tekstblok",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkop" },
    { "type": "text", "id": "heading", "label": "Kop" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Vertel hier je verhaal.</p>" },
    { "type": "text", "id": "cta_label", "label": "Knop" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    { "type": "select", "id": "background", "label": "Achtergrond", "default": "white",
      "options": [ { "value": "white", "label": "Wit" }, { "value": "sand", "label": "Zacht" } ] }
  ],
  "presets": [ { "name": "Tekstblok" } ]
}
{% endschema %}
