  {
    "name": "Winkelwagen",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type winkelwagen",
        "options": [
          {
            "value": "drawer",
            "label": "Zijpaneel (aanbevolen)"
