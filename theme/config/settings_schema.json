      },
      {
        "type": "text",
        "id": "company_email",
        "label": "E-mailadres klantenservice"
      },
      {
        "type": "text",
        "id": "support_hours",
        "label": "Bereikbaarheid",
        "info": "Bijvoorbeeld: ma t/m vr 9:00–17:00. Beloof alleen tijden die je waarmaakt."
      }
    ]
  },
  {
    "name": "Claims en reviews",
    "settings": [
      {
        "type": "paragraph",
        "content": "Belangrijk: laat deze velden leeg tenzij je de claim kunt onderbouwen. Een niet-onderbouwde claim over aantallen klanten of levertijd is misleidende handelspraktijk (art. 6:193b BW) en beschadigt je geloofwaardigheid meer dan dat een lege plek dat doet. Alle velden hieronder zijn daarom standaard leeg."
      },
      {
        "type": "text",
        "id": "claim_customer_count",
        "label": "Klantenaantal",
        "info": "Bijvoorbeeld: 25.000+ klanten. Vul dit uitsluitend in als je het cijfer met orderdata kunt aantonen."
      },
      {
        "type": "text",
        "id": "claim_delivery",
        "label": "Levertijdbelofte",
        "info": "Bijvoorbeeld: voor 16:00 besteld, morgen in huis. Vul hier de levertijd in die je daadwerkelijk haalt — niet de levertijd die je zou willen halen. Een gemiste belofte kost meer omzet dan een eerlijke, langere levertijd."
      },
      {
        "type": "text",
        "id": "claim_returns",
        "label": "Retourbelofte",
        "default": "14 dagen bedenktijd"
      },
      {
        "type": "header",
