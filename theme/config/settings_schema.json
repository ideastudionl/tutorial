  {
    "name": "Typografie",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Koppen",
        "default": "sans_serif_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Bodytekst",
        "default": "sans_serif_n4"
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "label": "Schaal bodytekst",
