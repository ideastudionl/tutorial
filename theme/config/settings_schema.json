        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "label": "Schaal koppen",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "select",
        "id": "heading_transform",
        "label": "Weergave koppen",
        "options": [
          {
            "value": "none",
            "label": "Normaal"
          },
          {
            "value": "uppercase",
            "label": "Hoofdletters"
          }
        ],
        "default": "none"
      }
    ]
