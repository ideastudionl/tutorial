  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "t:settings.typography.heading",
        "default": "assistant_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "t:settings.typography.body",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "label": "t:settings.typography.body_scale",
        "min": 90,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "label": "t:settings.typography.heading_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "select",
        "id": "heading_transform",
        "label": "t:settings.typography.heading_transform",
        "options": [
          { "value": "none", "label": "t:settings.typography.transform_none" },
          { "value": "uppercase", "label": "t:settings.typography.transform_upper" }
        ],
        "default": "none"
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "t:settings.layout.page_width",
        "min": 1200,
        "max": 1600,
        "step": 40,
        "unit": "px",
        "default": 1360
      },
      {
        "type": "range",
        "id": "radius_card",
        "label": "t:settings.layout.radius_card",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "radius_button",
        "label": "t:settings.layout.radius_button",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 8
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "t:settings.layout.animations",
        "info": "t:settings.layout.animations_info",
        "default": true
      }
    ]
  },
