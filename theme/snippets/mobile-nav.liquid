<aside class="drawer drawer--left" id="MenuDrawer" aria-label="{{ 'accessibility.menu' | t }}" aria-hidden="true">
  <div class="drawer__head">
    <h2 class="drawer__title">{{ 'accessibility.menu' | t }}</h2>
    <button type="button" class="icon-btn" data-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon', name: 'close', size: 18 %}
    </button>
  </div>

  <div class="drawer__body">
    <nav class="mobile-nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="mobile-nav__list">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <button type="button" class="mobile-nav__toggle" aria-expanded="false"
                aria-controls="MobilePanel-{{ forloop.index }}">
                {{ link.title }}
                {% render 'icon', name: 'chevron-down', size: 14 %}
              </button>
              <div class="mobile-nav__panel" id="MobilePanel-{{ forloop.index }}">
                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    {%- for grandchild in child.links -%}
                      <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                    {%- endfor -%}
                  {%- else -%}
                    <a href="{{ child.url }}">{{ child.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
                <a href="{{ link.url }}"><strong>{{ link.title }}</strong></a>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="mobile-nav__meta">
        <a href="{{ routes.account_url }}">
          {% render 'icon', name: 'account', size: 18 %}
          {{ 'sections.header.account' | t }}
        </a>
        {%- if settings.company_email != blank -%}
          <a href="mailto:{{ settings.company_email }}">
            {% render 'icon', name: 'mail', size: 18 %}
            {{ settings.company_email }}
          </a>
        {%- endif -%}
        {%- if settings.company_phone != blank -%}
          <a href="tel:{{ settings.company_phone | remove: ' ' }}">
            {% render 'icon', name: 'phone', size: 18 %}
            {{ settings.company_phone }}
          </a>
        {%- endif -%}
      </div>
    </nav>
  </div>
</aside>
