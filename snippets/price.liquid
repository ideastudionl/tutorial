{%- comment -%}
  Price display. Accepts: product (or variant via `target`), class.
  Shows a compare-at price and the saving only when there genuinely is one.
{%- endcomment -%}
{%- liquid
  assign target = target | default: product
  assign compare = target.compare_at_price
  if target.price_varies and show_from
    assign is_range = true
  endif
  assign on_sale = false
  if compare and compare > target.price
    assign on_sale = true
  endif
-%}
<span class="price {{ class }}{% if on_sale %} price--on-sale{% endif %}">
  {%- if is_range -%}
    <span class="price__current">{{ 'products.product.from_price' | t: price: target.price_min | money }}</span>
  {%- else -%}
    <span class="price__current">{{ target.price | money }}</span>
  {%- endif -%}

  {%- if on_sale -%}
    <s class="price__was">
      <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
      {{ compare | money }}
    </s>
    {%- if settings.card_show_savings -%}
      {%- assign saved = compare | minus: target.price -%}
      <span class="price__save">{{ 'products.product.save_amount' | t: amount: saved | money }}</span>
    {%- endif -%}
  {%- endif -%}

  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      {{ target.unit_price | money }} / {{ target.unit_price_measurement.reference_value }}{{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</span>
