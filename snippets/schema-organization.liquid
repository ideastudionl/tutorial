{%- comment -%}
  Organization schema. Only emits the fields the merchant has actually filled
  in — an empty or placeholder KvK/phone in structured data is worse than
  none, because it is machine-read and quoted back by search engines.
{%- endcomment -%}
{%- capture org_schema -%}
{
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}
  {%- if settings.logo %},
  "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }}
  {%- endif -%}
  {%- if settings.company_legal_name != blank %},
  "legalName": {{ settings.company_legal_name | json }}
  {%- endif -%}
  {%- if settings.company_vat != blank %},
  "vatID": {{ settings.company_vat | json }}
  {%- endif -%}
  {%- if settings.company_address != blank %},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ settings.company_address | json }},
    "addressCountry": "NL"
  }
  {%- endif -%}
  {%- if settings.company_phone != blank or settings.company_email != blank %},
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service"
    {%- if settings.company_phone != blank %},
    "telephone": {{ settings.company_phone | json }}
    {%- endif -%}
    {%- if settings.company_email != blank %},
    "email": {{ settings.company_email | json }}
    {%- endif -%}
  }
  {%- endif -%}
  {%- assign socials = '' -%}
  {%- if settings.social_instagram != blank %}{% assign socials = socials | append: settings.social_instagram | append: '|' %}{% endif -%}
  {%- if settings.social_facebook != blank %}{% assign socials = socials | append: settings.social_facebook | append: '|' %}{% endif -%}
  {%- if settings.social_tiktok != blank %}{% assign socials = socials | append: settings.social_tiktok | append: '|' %}{% endif -%}
  {%- if settings.social_youtube != blank %}{% assign socials = socials | append: settings.social_youtube | append: '|' %}{% endif -%}
  {%- if socials != blank -%}
    {%- assign social_list = socials | split: '|' -%},
  "sameAs": [{% for s in social_list %}{{ s | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
  {%- endif -%}
}
{%- endcapture -%}
<script type="application/ld+json">{{ org_schema }}</script>
